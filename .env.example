# ===========================================================================
# BOOM SHORTS — environment variables
#
# Copy to `.env.local` for local development. In production set these as
# deployment secrets (Vercel → Project → Settings → Environment Variables).
# NEVER commit real values. `.env*` is git-ignored.
# ===========================================================================

# --- Database (REQUIRED) ---------------------------------------------------
# Supabase → Project Settings → Database → Connection string (URI).
# Use the *pooler* connection string (port 6543) on serverless platforms.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional: set to "require" to enforce certificate validation on the DB
# connection. Leave unset in development.
# DATABASE_SSL=require
# DATABASE_POOL_MAX=5

# --- Supabase Storage (payment screenshots) --------------------------------
# Screenshots go to a PRIVATE bucket; only the object path is stored in the
# database and admins view them via short-lived signed URLs.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER-SIDE SECRET — never expose
SUPABASE_SCREENSHOT_BUCKET=payment-screenshots

# Create the bucket once (Supabase dashboard → Storage → New bucket, PRIVATE),
# or with the SQL editor:
#   insert into storage.buckets (id, name, public)
#   values ('payment-screenshots', 'payment-screenshots', false);

# --- Vercel Blob (fallback only) -------------------------------------------
# Used for screenshots ONLY when Supabase Storage is not configured.
# BLOB_READ_WRITE_TOKEN=

# --- Admin bootstrap (optional) --------------------------------------------
# If set, the first admin account is created automatically on first request.
# If omitted, /admin/login shows a one-time setup form while no admin exists.
# ADMIN_EMAIL=admin@boomshorts.local
# ADMIN_PASSWORD=change-me-123

# --- Upload permission signing ---------------------------------------------
# Signs the short-lived token that lets a customer upload a checkout
# screenshot. Set a long random string in production.
UPLOAD_TOKEN_SECRET=replace-with-a-long-random-string

# --- WhatsApp Cloud API (optional) -----------------------------------------
# Only needed for AUTOMATIC server-side order notifications. Without these the
# customer uses the prefilled wa.me link on the success page (works fine).
# Meta → WhatsApp → API Setup.
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
