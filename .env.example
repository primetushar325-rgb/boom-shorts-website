# ---------------------------------------------------------------------------
# Boom Shorts — environment variables
#
# Copy this file to .env.local for local development, and set the real values
# in the existing Vercel project (Settings → Environment Variables).
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Postgres connection string (Supabase → Project Settings → Database → Connection string → URI).
# Use the connection pooler URI on Vercel.
DATABASE_URL=postgresql://postgres.xxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase project URL — used for Storage (payment screenshots + site images).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Public anon key (safe for the browser; only needed if you later use the Supabase client in the UI).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side secret key (Supabase → Project Settings → API keys → secret key).
# Required for uploading payment screenshots to the private bucket and for
# generating short-lived admin-only signed URLs. Server-side only — never expose it.
SUPABASE_SECRET_KEY=

# Optional legacy fallback. Only used when SUPABASE_SECRET_KEY is empty.
# If both are set, SUPABASE_SECRET_KEY always wins.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: signs admin/customer session cookies. When empty it is derived
# automatically from DATABASE_URL, so it is not required.
SESSION_SECRET=

# Optional: canonical site URL used by metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://boom-shorts-website.vercel.app

# Optional:
# - Vercel Blob token. Used for public image uploads when Supabase Storage is not configured.
# BLOB_READ_WRITE_TOKEN=
# - Password used only the very first time settings are created (defaults to admin123).
# ADMIN_DEFAULT_PASSWORD=
