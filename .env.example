# ===========================================================================
# BOOM SHORTS — environment variables
#
# Copy to `.env.local` for local development. In production set these as
# deployment secrets (Vercel → Project → Settings → Environment Variables).
# NEVER commit real values. `.env*` is git-ignored.
# ===========================================================================

# --- Database (REQUIRED) ---------------------------------------------------
# Supabase → Project Settings → Database → Connection string (URI).
# Use the *pooler* connection string (port 6543) on serverless platforms.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional: set to "require" to enforce certificate validation on the DB
# connection. Leave unset in development.
# DATABASE_SSL=require
# DATABASE_POOL_MAX=5

# --- Supabase Storage (payment screenshots) --------------------------------
# Screenshots go to a PRIVATE bucket; only the object path is stored in the
# database and admins view them via short-lived signed URLs.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Either key format works — set whichever your dashboard shows:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # legacy JWT (role: service_role)
# SUPABASE_SECRET_KEY=sb_secret_your-secret-key    # newer API key format
# BOTH are SERVER-SIDE SECRETS — never expose to the browser.
SUPABASE_SCREENSHOT_BUCKET=payment-screenshots

# Create the bucket once (Supabase dashboard → Storage → New bucket, PRIVATE),
# or with the SQL editor:
#   insert into storage.buckets (id, name, public)
#   values ('payment-screenshots', 'payment-screenshots', false);

# --- Public site URL -------------------------------------------------------
# Used only to build absolute URLs in robots.txt and sitemap.xml. This is a
# PUBLIC value, not a secret — it is safe to inline. Defaults to
# https://boomshorts.com if unset, which is almost certainly wrong for you.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Screenshot storage ----------------------------------------------------
# Supabase Storage (private bucket) is the primary and recommended backend.
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above enable it. Create the bucket
# as PRIVATE:  Storage -> New bucket -> name "payment-screenshots" -> private.
# Optional override of the bucket name:
# SUPABASE_SCREENSHOT_BUCKET=payment-screenshots
#
# Vercel Blob objects are PUBLIC. A payment screenshot contains a transaction
# id and a phone number, so this fallback is disabled unless you opt in.
# ALLOW_PUBLIC_SCREENSHOT_FALLBACK=false

# --- Vercel Blob (fallback only) -------------------------------------------
# Used for screenshots ONLY when Supabase Storage is not configured.
# BLOB_READ_WRITE_TOKEN=

# --- Admin bootstrap (optional) --------------------------------------------
# If set, the first admin account is created automatically on first request.
# If omitted, /admin/login shows a one-time setup form while no admin exists.
# ADMIN_EMAIL=admin@boomshorts.local
# ADMIN_PASSWORD=change-me-123

# --- Upload permission signing ---------------------------------------------
# Signs the short-lived token that lets a customer upload a checkout
# screenshot. Set a long random string in production.
UPLOAD_TOKEN_SECRET=replace-with-a-long-random-string

# --- WhatsApp ---------------------------------------------------------------
# No credentials needed. Boom Shorts uses the FREE click-to-chat flow: the
# order page gives the customer a prefilled wa.me link addressed to the
# business number below, which is editable in Admin → Settings.
# There is deliberately no WhatsApp Cloud API / token / paid service.

